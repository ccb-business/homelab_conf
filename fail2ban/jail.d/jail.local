[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
backend = auto
ignoreip = 127.0.0.1/8 10.0.0.0/24 100.64.0.0/10

[sshd]
enabled = true
port = 22
logpath = /var/log/auth.log
maxretry = 5
bantime = 2h

[traefik-auth]
enabled = true
port = http,https
filter = traefik-auth
logpath = /var/log/traefik/access.log
maxretry = 15
findtime = 2m
bantime = 30m

[keycloak]
enabled = true
port = http,https
filter = keycloak
logpath = /var/log/keycloak/keycloak.log
maxretry = 5
findtime = 5m
bantime = 1h
